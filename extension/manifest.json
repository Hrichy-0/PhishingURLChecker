{
  "manifest_version": 3,
  "name": "PhishGuard URL Checker",
  "version": "0.1.0",
  "description": "Checks the active tab URL with a local URL-only phishing model.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "Check this URL with PhishGuard",
    "default_popup": "popup.html"
  }
}
